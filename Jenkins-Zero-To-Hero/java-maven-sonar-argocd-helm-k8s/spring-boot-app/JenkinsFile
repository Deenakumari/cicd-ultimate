pipeline {

    agent any

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'

        MANIFEST_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'

        SONAR_URL = 'http://3.88.239.200:9000'

        DOCKER_IMAGE = "deena012/ultimate-cicd:${BUILD_NUMBER}"

        GIT_REPO_NAME = 'cicd-ultimate'

        GIT_USER_NAME = 'Deenakumari'
    }

    stages {

        /*
         * ============================================================
         * CHECKOUT
         * ============================================================
         */

        stage('Checkout') {

            steps {

                echo '===== CHECKOUT ====='

                deleteDir()

                git(
                    branch: 'main',
                    url: 'https://github.com/Deenakumari/cicd-ultimate.git'
                )

                sh '''
                    set -e

                    echo "===== GIT COMMIT ====="

                    git log -1 --oneline

                    echo "===== APPLICATION DIRECTORY ====="

                    ls -la "$APP_DIR"

                    echo "===== CHECK POM ====="

                    test -f "$APP_DIR/pom.xml"

                    echo "===== CHECK DEPLOYMENT FILE ====="

                    test -f "$MANIFEST_FILE"

                    echo "===== CURRENT IMAGE ====="

                    grep -n "image:" "$MANIFEST_FILE" || true
                '''
            }
        }


        /*
         * ============================================================
         * BUILD AND TEST
         * ============================================================
         */

        stage('Build and Test') {

            steps {

                echo '===== BUILD AND TEST ====='

                sh '''
                    set -e

                    echo "===== MAVEN VERSION ====="

                    docker run --rm \
                        --entrypoint="" \
                        --user "$(id -u):$(id -g)" \
                        -e MAVEN_CONFIG=/tmp/.m2 \
                        jenkins-maven-java21-docker:1.0 \
                        mvn -version

                    echo "===== MAVEN CLEAN PACKAGE ====="

                    docker run --rm \
                        --entrypoint="" \
                        --user "$(id -u):$(id -g)" \
                        -e MAVEN_CONFIG=/tmp/.m2 \
                        -v "$WORKSPACE:/workspace" \
                        -w "/workspace/$APP_DIR" \
                        jenkins-maven-java21-docker:1.0 \
                        mvn \
                        -Dmaven.repo.local=/tmp/.m2/repository \
                        clean package

                    echo "===== BUILD SUCCESSFUL ====="
                '''
            }
        }


        /*
         * ============================================================
         * SONARQUBE
         * ============================================================
         */

        stage('Static Code Analysis') {

            steps {

                echo '===== STATIC CODE ANALYSIS ====='

                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "===== CHECK SONARQUBE ====="

                        curl -f -s \
                            "$SONAR_URL/api/system/status"

                        echo

                        echo "===== SONARQUBE VERSION ====="

                        curl -f -s \
                            "$SONAR_URL/api/server/version"

                        echo

                        echo "===== START SONAR ANALYSIS ====="

                        docker run --rm \
                            --entrypoint="" \
                            --user "$(id -u):$(id -g)" \
                            -e MAVEN_CONFIG=/tmp/.m2 \
                            -e SONAR_USER_HOME=/tmp/.sonar \
                            -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                            -v "$WORKSPACE:/workspace" \
                            -w "/workspace/$APP_DIR" \
                            jenkins-maven-java21-docker:1.0 \
                            mvn \
                            -Dmaven.repo.local=/tmp/.m2/repository \
                            -Dsonar.userHome=/tmp/.sonar \
                            org.sonarsource.scanner.maven:5.7.0.6970:sonar \
                            -Dsonar.host.url="$SONAR_URL" \
                            -Dsonar.token="$SONAR_TOKEN"

                        echo "===== SONAR ANALYSIS SUCCESSFUL ====="
                    '''
                }
            }
        }


        /*
         * ============================================================
         * DOCKER BUILD
         * ============================================================
         */

        stage('Build Docker Image') {

            steps {

                echo '===== BUILD DOCKER IMAGE ====='

                sh '''
                    set -e

                    echo "Docker Image:"
                    echo "$DOCKER_IMAGE"

                    cd "$APP_DIR"

                    docker build \
                        -t "$DOCKER_IMAGE" \
                        .

                    echo "===== DOCKER IMAGE CREATED ====="

                    docker image inspect "$DOCKER_IMAGE"
                '''
            }
        }


        /*
         * ============================================================
         * DOCKER PUSH
         * ============================================================
         */

        stage('Push Docker Image') {

            steps {

                echo '===== PUSH DOCKER IMAGE ====='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "===== DOCKER LOGIN ====="

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "===== DOCKER PUSH ====="

                        docker push "$DOCKER_IMAGE"

                        echo "===== DOCKER LOGOUT ====="

                        docker logout

                        echo "===== DOCKER PUSH SUCCESSFUL ====="

                        echo "Pushed:"
                        echo "$DOCKER_IMAGE"
                    '''
                }
            }
        }


        /*
         * ============================================================
         * UPDATE KUBERNETES DEPLOYMENT
         * ============================================================
         */

        stage('Update Deployment File') {

            steps {

                echo '===== UPDATE DEPLOYMENT FILE ====='

                sh '''
                    set -e

                    echo "===== BEFORE UPDATE ====="

                    grep -n "image:" "$MANIFEST_FILE"

                    echo "===== NEW IMAGE ====="

                    echo "$DOCKER_IMAGE"

                    echo "===== UPDATING IMAGE ====="

                    python3 - "$MANIFEST_FILE" "$DOCKER_IMAGE" <<'PY'

import sys
import re

manifest_file = sys.argv[1]
new_image = sys.argv[2]

with open(manifest_file, "r") as f:
    content = f.read()

pattern = r'(^[ \\t]*image:[ \\t]*)deena012/ultimate-cicd:[^ \\t\\r\\n]+'

updated_content, count = re.subn(
    pattern,
    lambda match: match.group(1) + new_image,
    content,
    flags=re.MULTILINE
)

if count == 0:
    print("ERROR: Could not find deena012/ultimate-cicd image")
    sys.exit(1)

with open(manifest_file, "w") as f:
    f.write(updated_content)

print("Updated image references:", count)
print("New image:", new_image)

PY

                    echo "===== AFTER UPDATE ====="

                    grep -n "image:" "$MANIFEST_FILE"

                    echo "===== VERIFY IMAGE ====="

                    grep -q "image: $DOCKER_IMAGE" "$MANIFEST_FILE"

                    echo "===== DEPLOYMENT IMAGE UPDATED SUCCESSFULLY ====="
                '''
            }
        }


        /*
         * ============================================================
         * GITHUB COMMIT AND PUSH
         * ============================================================
         */

        stage('Commit and Push Manifest') {

            steps {

                echo '===== COMMIT AND PUSH ====='

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "===== GIT CONFIG ====="

                        git config user.email "deenamadhumanchi@gmail.com"

                        git config user.name "Deenakumari"

                        echo "===== GIT STATUS ====="

                        git status

                        echo "===== GIT DIFF ====="

                        git diff -- "$MANIFEST_FILE"

                        echo "===== GIT ADD ====="

                        git add "$MANIFEST_FILE"

                        echo "===== STAGED DIFF ====="

                        git diff --cached

                        if git diff --cached --quiet; then

                            echo "No deployment changes to commit."

                        else

                            echo "===== GIT COMMIT ====="

                            git commit \
                                -m "Update deployment image to version ${BUILD_NUMBER}"

                            echo "===== GIT PUSH ====="

                            git push \
                                "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                                HEAD:main

                            echo "===== GITHUB PUSH SUCCESSFUL ====="

                        fi
                    '''
                }
            }
        }
    }


    /*
     * ================================================================
     * POST
     * ================================================================
     */

    post {

        success {

            echo '''
========================================
       PIPELINE SUCCESSFUL
========================================
'''

            echo "Build Number : ${BUILD_NUMBER}"

            echo "Docker Image : ${DOCKER_IMAGE}"

            echo "Deployment   : ${MANIFEST_FILE}"
        }

        failure {

            echo '''
========================================
         PIPELINE FAILED
========================================
'''

            echo "Build Number : ${BUILD_NUMBER}"

            echo "Check the failed stage above."
        }

        always {

            echo '===== PIPELINE COMPLETED ====='
        }
    }
}

pipeline {

    agent any

    environment {
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'

        SONAR_URL = 'http://3.88.239.200:9000'

        DOCKER_IMAGE = "deena012/ultimate-cicd:${BUILD_NUMBER}"

        GIT_REPO_NAME = 'cicd-ultimate'
        GIT_USER_NAME = 'Deenakumari'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '===== CHECKOUT ====='

                git branch: 'main',
                    url: 'https://github.com/Deenakumari/cicd-ultimate.git'

                sh '''
                    echo "===== GIT STATUS ====="
                    git status

                    echo "===== PROJECT FILES ====="
                    ls -la
                '''
            }
        }

        stage('Build and Test') {
            steps {
                echo '===== BUILD AND TEST ====='

                sh '''
                    docker run --rm \
                        --entrypoint="" \
                        --user root \
                        -v "$WORKSPACE":/workspace \
                        -w /workspace/$APP_DIR \
                        jenkins-maven-java21-docker:1.0 \
                        mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            steps {
                echo '===== SONARQUBE ANALYSIS ====='

                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {

                    sh '''
                        docker run --rm \
                            --entrypoint="" \
                            --user root \
                            -v "$WORKSPACE":/workspace \
                            -w /workspace/$APP_DIR \
                            jenkins-maven-java21-docker:1.0 \
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.token="$SONAR_AUTH_TOKEN" \
                            -Dsonar.host.url="$SONAR_URL"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '===== BUILD DOCKER IMAGE ====='

                sh '''
                    cd "$APP_DIR"

                    docker build \
                        -t "$DOCKER_IMAGE" \
                        .
                '''

                sh '''
                    echo "===== DOCKER IMAGE CREATED ====="
                    docker images | grep ultimate-cicd || true
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                echo '===== PUSH DOCKER IMAGE ====='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE"

                        docker logout
                    '''
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                echo '===== UPDATE DEPLOYMENT FILE ====='

                sh '''
                    set -e

                    echo "===== MANIFEST BEFORE UPDATE ====="

                    grep -n "image:" "$MANIFEST_FILE"

                    echo "===== UPDATING IMAGE ====="

                    sed -i -E \
                        "s|^[[:space:]]*image:.*|        image: ${DOCKER_IMAGE}|" \
                        "$MANIFEST_FILE"

                    echo "===== MANIFEST AFTER UPDATE ====="

                    grep -n "image:" "$MANIFEST_FILE"

                    echo "===== VERIFY IMAGE TAG ====="

                    grep -q "${DOCKER_IMAGE}" "$MANIFEST_FILE"

                    echo "Image update successful."
                '''
            }
        }

        stage('Commit and Push Manifest') {
            steps {
                echo '===== COMMIT AND PUSH MANIFEST ====='

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        git config user.email "deenamadhumanchi@gmail.com"
                        git config user.name "Deenakumari"

                        echo "===== GIT STATUS ====="
                        git status

                        echo "===== GIT DIFF ====="
                        git diff -- "$MANIFEST_FILE"

                        git add "$MANIFEST_FILE"

                        echo "===== STAGED CHANGES ====="
                        git diff --cached

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}" \
                            || echo "No changes to commit"

                        echo "===== PUSHING TO GITHUB ====="

                        git push \
                            "https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git" \
                            HEAD:main

                        echo "===== GITHUB PUSH SUCCESSFUL ====="
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo '       PIPELINE SUCCESSFUL'
            echo '========================================'

            echo "Build Number : ${BUILD_NUMBER}"
            echo "Docker Image : ${DOCKER_IMAGE}"
            echo "Manifest     : ${MANIFEST_FILE}"
        }

        failure {
            echo '========================================'
            echo '          PIPELINE FAILED'
            echo '========================================'

            echo "Build Number : ${BUILD_NUMBER}"
        }

        always {
            echo '===== PIPELINE COMPLETED ====='
        }
    }
}                   

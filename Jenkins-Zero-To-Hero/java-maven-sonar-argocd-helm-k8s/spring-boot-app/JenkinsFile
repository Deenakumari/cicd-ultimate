pipeline {
  agent {
    docker {
      image 'jenkins-maven-java21-docker:1.0'
      args '--entrypoint="" --user root -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/jenkins/m2:/root/.m2'
    }
  }

  stages {

    stage('Checkout') {
      steps {
        sh 'echo passed'
      }
    }

    stage('Build and Test') {
      steps {
        sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn -Dmaven.repo.local=/root/.m2/repository clean package'
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = 'http://3.88.239.200:9000'
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh '''
            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
            mvn -Dmaven.repo.local=/root/.m2/repository \
            org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar \
            -Dsonar.token=$SONAR_AUTH_TOKEN \
            -Dsonar.host.url=$SONAR_URL
          '''
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "deena012/ultimate-cicd:${BUILD_NUMBER}"
      }
      steps {
        script {
          sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
          def dockerImage = docker.image("${DOCKER_IMAGE}")
          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            dockerImage.push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "deenamadhumanchi@gmail.com"
            git config user.name "Deenakumari"

            sed -i -E "s|(image: deena012/ultimate-cicd:).*|\\1${BUILD_NUMBER}|" \
            java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

            git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
            git commit -m "Update deployment image to ${BUILD_NUMBER}" || true

            git push https://${GITHUB_TOKEN}@github.com/Deenakumari/cicd-ultimate.git HEAD:main
          '''
        }
      }
    }
  }
}

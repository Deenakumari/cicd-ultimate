pipeline {
    agent {
        docker {
            image 'jenkins-maven-java21-docker:1.0'
            args '--entrypoint="" --user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Deenakumari/cicd-ultimate.git'
            }
        }

        stage('Build and Test') {
            steps {
                sh 'ls -ltr'

                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = 'http://3.88.239.200:9000'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.token=$SONAR_AUTH_TOKEN \
                            -Dsonar.host.url=$SONAR_URL
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "deena012/ultimate-cicd:${BUILD_NUMBER}"
            }

            steps {
                script {

                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        docker build \
                            -t ${DOCKER_IMAGE} .
                    '''

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = 'cicd-ultimate'
                GIT_USER_NAME = 'Deenakumari'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "===== GIT STATUS ====="
                        git status

                        echo "===== GIT REMOTE ====="
                        git remote -v

                        git config user.email "deenamadhumanchi@gmail.com"
                        git config user.name "Deenakumari"

                        echo "===== UPDATE IMAGE TAG ====="

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                        java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "===== GIT ADD ====="

                        git add \
                        java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                        echo "===== GIT DIFF ====="

                        git diff --cached

                        echo "===== GIT COMMIT ====="

                        git commit \
                            -m "Update deployment image to version ${BUILD_NUMBER}" || true

                        echo "===== GIT PUSH ====="

                        git push \
                            https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main
                    '''
                }
            }
        }
    }
}
